# Deny by default: private files never enter the build context.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!backend/
!backend/counterpress/
!backend/counterpress/**/
!backend/counterpress/**/*.py
!fixtures/
!fixtures/**/
!fixtures/**/*.json
!fixtures/**/*.json.gz
!integrations/
!integrations/personalization/
!integrations/personalization/client.ts
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/index.html
!frontend/auth.html
!frontend/src/
!frontend/src/**/
!frontend/src/**/*.ts
!frontend/src/**/*.tsx
!frontend/src/**/*.css
!frontend/src/football/portraits/
!frontend/src/football/portraits/*.webp
# Tests are not needed by the production frontend build.
frontend/src/**/*.test.ts
frontend/src/**/*.test.tsx

# Approved public header artwork required by FootieWordmark.
!frontend/src/assets/brand/footie-wordmark-forest-v1.webp
