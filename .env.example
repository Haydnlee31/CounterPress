# Copy to .env and fill locally. Do not commit .env or paste keys into chat.
# Use your resource endpoint, not a portal or management URL.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
AZURE_OPENAI_API_KEY=
# Keep this path the same for the API and adaptation/ingestion commands.
COUNTERPRESS_DB_PATH=var/counterpress.sqlite3

# Optional cloud history. Leave sqlite for local development.
COUNTERPRESS_STORAGE=sqlite
# Supply Cosmos endpoint and client ID through private runtime configuration.
# Cloud default: managed-identity; local authorized data access: azure-cli.
# COUNTERPRESS_COSMOS_ENDPOINT=
# COUNTERPRESS_COSMOS_DATABASE=counterpress
# COUNTERPRESS_COSMOS_CONTAINER=histories
# COUNTERPRESS_COSMOS_CLIENT_ID=
# COUNTERPRESS_COSMOS_AUTH=managed-identity

# Optional Azure streaming: configure privately via Bicep, never VITE_* settings.
# COUNTERPRESS_STREAMING=azure
# COUNTERPRESS_STREAM_CLIENT_ID=
# COUNTERPRESS_EVENTHUB_NAMESPACE=
# COUNTERPRESS_EVENTHUB_NAME=deliveries
# COUNTERPRESS_CHECKPOINT_ENDPOINT=
# COUNTERPRESS_PUBSUB_ENDPOINT=
# Explicit producer CLI: azure-cli locally, managed-identity inside the app.
# COUNTERPRESS_FEED_AUTH=azure-cli
# COUNTERPRESS_FEED_CLIENT_ID=

# Optional numeric streaming telemetry; cloud deployment enables this after the managed-identity ingestion rule is provisioned.
# COUNTERPRESS_TELEMETRY=off

# Editorial API remains disabled until Entra/live integration and human review.
# Never configure these in VITE_* variables. See docs/editorial-access.md.
COUNTERPRESS_EDITORIAL=off
# COUNTERPRESS_ENTRA_TENANT_ID=
# COUNTERPRESS_ENTRA_AUDIENCE=
# COUNTERPRESS_ENTRA_CLIENT_IDS=

# Studio factual review has no model dependency. Enable only after SPA registration.
# See docs/studio.md. Actual IDs stay in private runtime configuration.
COUNTERPRESS_STUDIO=off
# COUNTERPRESS_STUDIO_CLIENT_ID=
