# Copy to .env and fill locally. Do not commit .env or paste keys into chat.
# Use your resource endpoint, not a portal or management URL.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
AZURE_OPENAI_API_KEY=
# Keep this path the same for the API and adaptation/ingestion commands.
COUNTERPRESS_DB_PATH=var/counterpress.sqlite3

# Optional cloud history. Leave sqlite for local development.
COUNTERPRESS_STORAGE=sqlite
# Supply Cosmos endpoint and client ID through private runtime configuration.
# Cloud default: managed-identity; local authorized data access: azure-cli.
# COUNTERPRESS_COSMOS_ENDPOINT=
# COUNTERPRESS_COSMOS_DATABASE=counterpress
# COUNTERPRESS_COSMOS_CONTAINER=histories
# COUNTERPRESS_COSMOS_CLIENT_ID=
# COUNTERPRESS_COSMOS_AUTH=managed-identity
